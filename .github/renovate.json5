{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>scottames/renovate:default.json5',
  ],
  gitIgnoredAuthors: [
    '162828115+scottames-github-bot[bot]@users.noreply.github.com',
  ],
  lockFileMaintenance: {
    enabled: false,
  },
  customManagers: [
    {
      customType: 'regex',
      fileMatch: ['^go\\.mod$'],
      matchStrings: ['go (?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'go',
      datasourceTemplate: 'golang-version',
    },
    {
      customType: 'regex',
      fileMatch: ['^\\.trunk/trunk\\.yaml$'],
      matchStrings: ['- go@(?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'go',
      datasourceTemplate: 'golang-version',
    },
  ],
  packageRules: [
    {
      matchPackageNames: ['go', 'golang/go'],
      groupName: 'go',
      branchTopic: 'go',
    },
  ],
}
